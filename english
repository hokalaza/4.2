            local p = m:WaitForChild("BallPart", 10)
            if p then
                local mk = Instance.new("Part", Workspace)
                mk.Name         = "Marker"
                mk.Size         = Vector3.new(2, 2, 2)
                mk.Shape        = Enum.PartType.Ball
                mk.Material     = Enum.Material.Neon
