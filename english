local lastDiveTime = 0
-- Seed with last known valid tokens (reusable per session)
local bumpIds = {1778431578, 1434637888}
local diveIds  = {1778431574, 3644610408}
local playerActionRemote = nil

local function initRemote()
    local remotes = game.ReplicatedStorage:FindFirstChild("Remotes")
    if not remotes then return end
    playerActionRemote = remotes:FindFirstChild("PlayerAction")
    if not playerActionRemote then return end

    -- Hook to always capture the latest valid tokens
    local mt = getrawmetatable(game)
    local oldNamecall = mt.__namecall
    setreadonly(mt, false)
    mt.__namecall = function(self, ...)
        if self == playerActionRemote then
            local args = {...}
            local method = getnamecallmethod()
            if method == "FireServer" then
                local action = args[1]
                local token  = args[2]
                if action == "Receiving" and token then
                    bumpIds = token
                elseif action == "Diving" and token then
                    diveIds = token
                end
            end
        end
        return oldNamecall(self, ...)
    end
    setreadonly(mt, true)
end
initRemote()

local function fireAction(actionName)
    local ca = getActions()
    if actionName == "Bump" then
        -- Remote fires first so server expects the action before animation
        if playerActionRemote and bumpIds then
            pcall(function() playerActionRemote:FireServer("Receiving", bumpIds) end)
        end
        if ca then pcall(function() ca:Bump() end) end
    elseif actionName == "Dive" then
        if playerActionRemote and diveIds then
            pcall(function() playerActionRemote:FireServer("Diving", diveIds) end)
        end
        if ca then pcall(function() ca:Dive() end) end
    end
end
RunService.RenderStepped:Connect(function()
    local root = char:FindFirstChild("HumanoidRootPart")
    if not root then return end
    if speedOverride then
        local _ca = getActions()
        if _ca then _ca.State.WalkSpeed = _G.DesiredWalkSpeed end
    end
    local now      = os.clock()
    local ca       = getActions()
    local isDiving = (now - lastDiveTime) < 2.5

    if not isDiving and autoFollow then
        followClosestMarker()
        if autoReceive then
            local desired = getDesiredReceivePowerFromPosition(root.Position)
            adjustPowerTo(desired)
        end
    end

    if not ca or not ca.State then return end
    local stateReady = ca.State.Ready
    local stateDived = ca.State.Dived
    local playerSide = root.Position.Z >= 0 and 1 or -1

    for _, m in ipairs(Workspace:GetChildren()) do
        if m:IsA("Model") and m.Name == "Ball" then
            local part = m:FindFirstChild("BallPart")
            if part then
                local ballSide      = part.Position.Z >= 0 and 1 or -1
                local ballOtherSide = ballSide ~= playerSide

                -- Track ball speed
                local bd = ballData[part]
                if bd then
                    if bd.lastPos2 then
                        local elapsed = math.max(0.001, now - (bd.lastTime2 or now))
                        bd.speed = (part.Position - bd.lastPos2).Magnitude / elapsed
                    end
                    bd.lastPos2  = part.Position
                    bd.lastTime2 = now
                else
                    ballData[part] = { lastBump = 0, speed = 0, lastPos2 = part.Position, lastTime2 = now }
                end
                local isFast = (ballData[part] and ballData[part].speed or 0) >= (_G.MinBallSpeed or 30)

                if not ballOtherSide then
                    local dist = (part.Position - root.Position).Magnitude

                    if autoDive and stateReady and not stateDived
                    and not isDiving and dist <= _G.DiveDistance and isFast then
                        local mk = markers[m]
                        local rootPart = char:FindFirstChild("HumanoidRootPart")
                        -- Only dive if landing marker is close to player
                        -- Prevents wrong dive when spike lands near net but player is at back
                        local landingClose = true
                        if mk and rootPart then
                            local landingDist = (Vector3.new(mk.Position.X, rootPart.Position.Y, mk.Position.Z) - rootPart.Position).Magnitude
                            landingClose = landingDist <= _G.DiveDistance * 3
                        end
                        if landingClose then
                            lastDiveTime = now
                            isDiving     = true
                            if rootPart and mk then
                                local dir = Vector3.new(
                                    mk.Position.X - rootPart.Position.X,
                                    0,
                                    mk.Position.Z - rootPart.Position.Z
                                )
                                if dir.Magnitude > 0.1 then
                                    rootPart.CFrame = CFrame.new(rootPart.Position, rootPart.Position + dir)
                                end
                            end
                            fireAction("Dive")
                        end
                    end

                    if not isDiving and _G.BumpDistance and _G.BumpDistance > 0
                    and (not (_G.OnlyBumpWhenAutoFollow and not autoFollow))
                    and stateReady and not stateDived
                    and dist <= _G.BumpDistance then
                        local lastB = ballData[part] and ballData[part].lastBump or 0
                        if now - lastB >= 1.1 then
                            if not ballData[part] then
                                ballData[part] = { lastBump = 0, lastDive = 0 }
                            end
                            ballData[part].lastBump = now
                            fireAction("Bump")
                        end
                    end
                end
            end
        end
    end
end)
