-- Block Hitbox Predict
local bhpEnabled    = false
local bhpDelay      = 0.30
local bhpMarkers    = {}
local bhpGhost      = {}
local bhpLastPos    = {}
local bhpVelocity   = {}
local bhpHighlights = {}
local bhpPeakLocked = {}
local bhpPeakCFrame = {}

local function bhpSimulateAhead(pos, vel, time)
    local g  = Vector3.new(0, -workspace.Gravity, 0)
    local dt = 0.03
    local steps = math.ceil(time / dt)
    for _ = 1, steps do
        vel = vel + g * dt
        pos = pos + vel * dt
        if pos.Y <= 0 then return Vector3.new(pos.X, 0, pos.Z) end
    end
    return pos
end

local function bhpSimulateLanding(pos, vel)
    local g  = Vector3.new(0, -workspace.Gravity, 0)
    local dt = 0.03
    for _ = 1, 120 do
        vel = vel + g * dt
        pos = pos + vel * dt
        if pos.Y <= 0 then return Vector3.new(pos.X, 0, pos.Z) end
    end
    return pos
end

local function bhpClean(p)
    if bhpMarkers[p]    then bhpMarkers[p]:Destroy()    end
    if bhpGhost[p]      then bhpGhost[p]:Destroy()      end
    if bhpHighlights[p] then bhpHighlights[p]:Destroy() end
    bhpMarkers[p]    = nil
    bhpGhost[p]      = nil
    bhpHighlights[p] = nil
    bhpLastPos[p]    = nil
    bhpVelocity[p]   = nil
    bhpPeakLocked[p] = false
    bhpPeakCFrame[p] = nil
end

local function bhpInit(p)
    if p == player then return end
    bhpClean(p)
    bhpVelocity[p]   = Vector3.zero
    bhpPeakLocked[p] = false
end

local bhpLoop = nil
local function startBhp()
    for _, p in ipairs(Players:GetPlayers()) do bhpInit(p) end
    Players.PlayerAdded:Connect(bhpInit)
    Players.PlayerRemoving:Connect(bhpClean)
    bhpLoop = RunService:BindToRenderStep("PredictHitbox", Enum.RenderPriority.Camera.Value, function(dt)
        if not bhpEnabled then return end
        for _, p in ipairs(Players:GetPlayers()) do
            if p == player then continue end
            if not bhpVelocity[p] then continue end
            local ch  = p.Character
            if not ch then continue end
            local hitbox = ch:FindFirstChild("BlockHitbox")
            local hrp    = ch:FindFirstChild("HumanoidRootPart")
            local hum    = ch:FindFirstChildOfClass("Humanoid")
            if not (hitbox and hrp and hum) then continue end
            local pos = hrp.Position
            if bhpLastPos[p] then
                local rawVel = (pos - bhpLastPos[p]) / dt
                bhpVelocity[p] = bhpVelocity[p]:Lerp(rawVel, 0.2)
            end
            bhpLastPos[p] = pos
            local vy         = bhpVelocity[p].Y
            local isAirborne = hum.FloorMaterial == Enum.Material.Air
            if isAirborne then
                -- Recreate ghost if anticheat removed it
                if not bhpGhost[p] or not bhpGhost[p].Parent then
                    local g = Instance.new("Part")
                    g.Name         = "HitboxGhost"
                    g.Size         = hitbox.Size
                    g.Anchored     = true
                    g.CanCollide   = false
                    g.Transparency = 1
                    g.CastShadow   = false
                    g.Parent       = workspace
                    bhpGhost[p] = g
                    -- Force recreate highlight too since ghost changed
                    if bhpHighlights[p] then bhpHighlights[p]:Destroy(); bhpHighlights[p] = nil end
                end
                -- Recreate highlight if anticheat removed it
                if not bhpHighlights[p] or not bhpHighlights[p].Parent then
                    local h = Instance.new("SelectionBox")
                    h.Color3              = Color3.fromRGB(255, 80, 80)
                    h.LineThickness       = 0.05
                    h.SurfaceTransparency = 0.55
                    h.SurfaceColor3       = Color3.fromRGB(255, 80, 80)
                    h.Adornee             = bhpGhost[p]
                    h.Parent              = workspace
                    bhpHighlights[p] = h
                end
                -- Recreate marker if anticheat removed it
                if not bhpMarkers[p] or not bhpMarkers[p].Parent then
                    local mk = Instance.new("Part")
                    mk.Name         = "JumpMarker"
                    mk.Size         = Vector3.new(2, 0.3, 2)
                    mk.Anchored     = true
                    mk.CanCollide   = false
                    mk.Material     = Enum.Material.Neon
                    mk.Color        = Color3.fromRGB(80, 200, 255)
                    mk.Transparency = 0.5
                    mk.Parent       = workspace
                    bhpMarkers[p] = mk
                end
                bhpGhost[p].Size = hitbox.Size
                if not bhpPeakLocked[p] and vy <= 0 then
                    bhpPeakLocked[p] = true
                    bhpPeakCFrame[p] = bhpGhost[p].CFrame
                end
                if bhpPeakLocked[p] then
                    bhpGhost[p].CFrame = bhpPeakCFrame[p]
                else
                    local ghostPos = bhpSimulateAhead(pos, bhpVelocity[p], bhpDelay)
                    bhpGhost[p].CFrame = CFrame.new(ghostPos)
                end
                local landing = bhpSimulateLanding(pos, bhpVelocity[p])
                bhpMarkers[p].CFrame = CFrame.new(landing)
            else
                if bhpHighlights[p] then bhpHighlights[p]:Destroy(); bhpHighlights[p] = nil end
                if bhpGhost[p]      then bhpGhost[p]:Destroy();      bhpGhost[p]      = nil end
                if bhpMarkers[p]    then bhpMarkers[p]:Destroy();    bhpMarkers[p]    = nil end
                bhpPeakLocked[p] = false
                bhpPeakCFrame[p] = nil
            end
        end
    end)
end

local function stopBhp()
    RunService:UnbindFromRenderStep("PredictHitbox")
    for _, p in ipairs(Players:GetPlayers()) do bhpClean(p) end
end

tab.newInput("block hitboxes delay (second)", "0.30 default", function(t)
    bhpDelay = tonumber(t) or 0.30
end)
tab.newToggle("block hitboxes predict", "highlight & predict enemy jump landing", false, function(s)
    bhpEnabled = s
    if s then
        startBhp()
    else
        stopBhp()
    end
end)

local function registerBall(m)
    if not (m:IsA("Model") and m.Name == "Ball") then return end
    local p = m:FindFirstChild("BallPart")
    if p then ballData[p] = { lastBump = 0, lastDive = 0 } end
    -- Watch if BallPart gets replaced inside the model mid-game
    m.ChildAdded:Connect(function(child)
        if child.Name == "BallPart" then
            ballData[child] = { lastBump = 0, lastDive = 0 }
        end
    end)
    m.ChildRemoved:Connect(function(child)
        if child.Name == "BallPart" then
            ballData[child] = nil
        end
    end)
end

-- Scan balls that already exist when script runs
for _, m in ipairs(Workspace:GetChildren()) do
    registerBall(m)
end

Workspace.ChildAdded:Connect(function(m)
    if m:IsA("Model") and m.Name == "Ball" then
        task.spawn(function()
            local p = m:WaitForChild("BallPart", 10)
            if p then ballData[p] = { lastBump = 0, lastDive = 0 } end
        end)
        registerBall(m)
    end
end)
Workspace.ChildRemoved:Connect(function(m)
    if not (m:IsA("Model") and m.Name == "Ball") then return end
    for p, _ in pairs(ballData) do
        if type(p) == "userdata" and (not p.Parent or p.Parent == m) then
            ballData[p] = nil
        end
    end
end)

-- Cleanup stale entries + re-scan every 10s to catch any missed balls
local lastRescan = 0
RunService.Heartbeat:Connect(function()
    local now2 = os.clock()
    for p, _ in pairs(ballData) do
        if type(p) == "userdata" and not p.Parent then
            ballData[p] = nil
        end
    end
    if now2 - lastRescan >= 10 then
        lastRescan = now2
        for _, m in ipairs(Workspace:GetChildren()) do
            if m:IsA("Model") and m.Name == "Ball" then
                local p = m:FindFirstChild("BallPart")
                if p and not ballData[p] then
                    ballData[p] = { lastBump = 0, lastDive = 0 }
                end
            end
        end
    end
end)


