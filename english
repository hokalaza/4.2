local function followClosestMarker()
    local root = char:FindFirstChild("HumanoidRootPart")
    local hum  = char:FindFirstChildOfClass("Humanoid")
    if not (root and hum) then return end

    local playerSide = root.Position.Z >= 0 and 1 or -1

    local best, bd = nil, math.huge
    for m, mk in pairs(markers) do
        if mk and mk.Parent then
            local ballPart = m:FindFirstChild("BallPart")
            if ballPart then
                local ballSide = ballPart.Position.Z >= 0 and 1 or -1
                if ballSide ~= playerSide then
                    -- ball is on the other side of the net, skip
                else
                    local d = (mk.Position - root.Position).Magnitude
                    if d < bd then bd, best = d, mk end
                end
            else
                local d = (mk.Position - root.Position).Magnitude
                if d < bd then bd, best = d, mk end
            end
        end
    end
    if best and bd <= _G.FollowDistance then
        hum:MoveTo(best.Position)
    end
end
