                if ballLastPos[m] then
                    local rawVel = (pos - ballLastPos[m]) / dt
                    local velDiff = (rawVel - (ballVelocity[m] or Vector3.zero)).Magnitude
                    local alpha = math.clamp(velDiff / 60, 0.08, 1)
                    ballVelocity[m] = (ballVelocity[m] or Vector3.zero):Lerp(rawVel, alpha)
